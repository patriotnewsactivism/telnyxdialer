# Telnyx
TELNYX_API_KEY=your_telnyx_api_key
# Call Control App with a valid webhook URL — the dialable connection
TELNYX_CONNECTION_ID=your_call_control_connection_id
# Owned Telnyx number used as caller ID (SMS-enabled number for SMS)
TELNYX_FROM_NUMBER=+18329757665
# Public webhook URL Telnyx can reach (cloudflared tunnel or your domain)
TELNYX_WEBHOOK_URL=https://your-host/api/webhooks/telnyx

# AI voice providers (customizable per call / per campaign)
# Telephony-native (Telnyx): male | female  | Amazon Polly neural on compatible connections: Brian, Matthew, Joey, ...
TELNYX_TTS_VOICE=Brian
TELNYX_TTS_LANGUAGE=en-US
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_brian_clone_id
CARTESIA_API_KEY=your_cartesia_key
CARTESIA_VOICE_ID=your_cartesia_voice_id
OPENROUTER_API_KEY=your_openrouter_key          # LLM for notetaker summaries + agent brains
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Email (SMTP) — used for call summaries / notetaker delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=ai-dialer@example.com

# Takeover — number a live agent picks up when the callee requests a human
TAKEOVER_NUMBER=+18328804970

# Server
PORT=3000
HOST=0.0.0.0
BASE_URL=https://your-host          # used for recording/transcript links in emails
